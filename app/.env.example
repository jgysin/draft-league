# From the iOS app registered in the plleague Firebase project (GoogleService-Info.plist → CLIENT_ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Firebase console → Authentication → Sign-in method → Google → Web SDK configuration → Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Printed by `npx eas-cli@latest init`. Needed for EAS builds only.
EAS_PROJECT_ID=
