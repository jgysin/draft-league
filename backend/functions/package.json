{
  "name": "draft-league-functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run test/unit",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --project demo-draft-league --only firestore \"vitest run test/integration\"",
    "test": "npm run test:unit && npm run test:emulator",
    "migrate": "tsx scripts/migrate-legacy.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.33.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
